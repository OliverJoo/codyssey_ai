# b6-1 실습 공통 설정 예시다. 복사 후 config.env로 저장한다.
AWS_REGION="ap-northeast-2"
PROJECT_NAME="codyssey-b6-1"
VPC_CIDR="10.0.0.0/16"
SUBNET_CIDR="10.0.1.0/24"
INSTANCE_TYPE="t3.micro"
KEY_NAME="codyssey-b6-1-key"

# 반드시 현재 학습자 공인 IP 한 개만 CIDR로 입력한다. 예: 203.0.113.10/32
SSH_CIDR="CHANGE_ME/32"

# Amazon Linux 2023 최신 x86-64 AMI를 SSM 공개 파라미터로 조회한다.
AMI_SSM_PARAMETER="/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
